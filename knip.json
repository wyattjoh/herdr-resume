{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts!",
    "mod/index.ts!",
    "pi-extension/herdr-resume.ts!",
    "scripts/*.ts",
    "src/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "mod/**/*.ts!",
    "pi-extension/**/*.ts!",
    "!src/**/*.test.ts!",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": ["gpui-kit", "herdr", "lefthook"]
}
